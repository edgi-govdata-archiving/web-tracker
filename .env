# Environment variables you can use to configure the app for your environment.
# ----------------------------------------------------------------------------
# 
# DO NOT EDIT THIS FILE except to describe new environment variables (with no
# actual value) or to set *PUBLICLY SHARE-ABLE* default values.
# 
# Any local customizations for your development environment should go in a file
# named `.env.local`, which will be loaded and overlaid on top of this.

# Fill this in with a base-64 encoded JSON string of a service account key
# with access the publishable changes Google Sheet.
export GOOGLE_SERVICE_KEY='x'

# ID of Google sheet to load publishable changes from.
export PUBLISH_SHEET='y'

# Cells in the above sheet to read for publishing.
export PUBLISH_SHEET_RANGE = 'Staging!A:ZZ'
