  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build --dotenv .env --dotenv \".env.${NODE_ENV:-development}\" --dotenv .env.local",
    "dev": "nuxt dev --dotenv .env --dotenv \".env.${NODE_ENV:-development}\" --dotenv .env.local",
    "generate": "nuxt generate --dotenv .env --dotenv \".env.${NODE_ENV:-development}\" --dotenv .env.local",
    "preview": "nuxt preview --dotenv .env --dotenv \".env.${NODE_ENV:-development}\" --dotenv .env.local",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.0.1",
    "bottleneck": "^2.19.5",
    "markdown-it": "^15.0.2",
    "nodemon": "^3.1.9",
    "nunjucks": "^3.2.4",
    "nuxt": "^4.5.2",
    "path-browserify": "^1.0.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
